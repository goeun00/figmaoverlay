{
  "manifestVersion": 5,
  "id": "com.goeun.smart-export",
  "name": "Smart Export",
  "version": "1.4.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [
        ""
      ],
      "schemes": []
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "smart-export-panel",
      "label": {
        "default": "Smart Export"
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 380
      },
      "minimumSize": {
        "width": 300,
        "height": 210
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      }
    }
  ]
}